# Copy to .env.local and fill in. Never commit real values.
# On Vercel, set the same names in Project Settings > Environment Variables.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key only. This one is safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: SERVER ONLY. Used by lib/supabase/admin.ts and scripts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Auth.js ---
# Generate with: npx auth secret   (also used to hash phone sign-in codes)
AUTH_SECRET=
# Google OAuth. Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- SMS (Text.lk): phone sign-in and order notifications. Leave empty to keep SMS off. ---
TEXTLK_API_TOKEN=

# --- PayHere online card payments (payhere.lk > Side menu > Integrations). SERVER ONLY. ---
# Leave empty to keep online payment off. Use the SANDBOX id/secret while testing
# (sandbox.payhere.lk); the secret is tied to the domain you register there.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=

# --- Email (resend.com). SERVER ONLY. Leave empty to keep email off. ---
# Password reset, email confirmation, the newsletter double opt-in and order emails.
# EMAIL_FROM must be on a domain verified in Resend, e.g. "Northbound <orders@your-domain.lk>".
RESEND_API_KEY=
EMAIL_FROM=

# --- Push notifications, Firebase Cloud Messaging (console.firebase.google.com). Leave empty to keep push off. ---
# Web config: Project settings > General > Your apps > Web app (</>) > SDK setup. These are PUBLIC (baked in at
# build time, safe in the browser), so set them BEFORE `npm run build` / the Vercel deploy.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: only used if you add Firebase Auth later.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Project settings > Cloud Messaging > Web Push certificates > Generate key pair (the PUBLIC key).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Service account, SERVER ONLY: Project settings > Service accounts > Generate new private key (a JSON file).
# FIREBASE_PROJECT_ID = "project_id", FIREBASE_CLIENT_EMAIL = "client_email", FIREBASE_PRIVATE_KEY = "private_key"
# (keep the quotes and the \n sequences exactly as in the JSON). Never commit that JSON file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Public site address. Set when the domain exists (no trailing slash). ---
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
